{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:shield",
      "scripts": {
        "parent_setup": "c.item_slot == 'main_hand' ? { v.use_attachable_animations_main_hand = 1.0; } : { v.use_attachable_animations_off_hand = 1.0; };",
        "initialize": [
          "v.main_hand_first_person_pos_x = 1.1953128888;",
          "v.main_hand_first_person_pos_y = -16.1559317111;",
          "v.main_hand_first_person_pos_z = -0.5;",
          "v.main_hand_first_person_rot_x = 0.0;",
          "v.main_hand_first_person_rot_y = 0.0;",
          "v.main_hand_first_person_rot_z = -5.0;",
          "v.off_hand_first_person_pos_x = -3.1953128888;",
          "v.off_hand_first_person_pos_y = -16.1559317111;",
          "v.off_hand_first_person_pos_z = -0.5;",
          "v.off_hand_first_person_rot_x = 0.0;",
          "v.off_hand_first_person_rot_y = 0.0;",
          "v.off_hand_first_person_rot_z = 5.0;",
          "v.is_in_offhand = c.item_slot == 'off_hand';"
        ],
        "pre_animation": [
          "v.is_blocking_main_hand = q.blocking && !q.is_item_name_any('slot.weapon.offhand', 'minecraft:shield', 'tcsmp:tnt_shield') && q.is_item_name_any('slot.weapon.mainhand', 'minecraft:shield');",
          "v.is_blocking_off_hand = q.blocking && q.is_item_name_any('slot.weapon.offhand', 'minecraft:shield');",
          "v.is_first_person = c.is_first_person;"
        ]
      },
      "render_controllers": [ "controller.render.shield" ]
    }
  }
}
