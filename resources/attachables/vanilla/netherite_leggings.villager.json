{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:netherite_leggings.villager",
      "item": { "minecraft:netherite_leggings": "query.is_owner_identifier_any('minecraft:zombie_villager', 'minecraft:zombie_villager_v2')" },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/netherite_2",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "baby": "textures/models/armor/netherite_baby"
      },
      "geometry": {
        "default": "geometry.humanoid.armor.leggings",
        "baby": "geometry.villager.baby.armor.leggings"
      },
      "scripts": {
        "pre_animation": [
          "variable.use_baby_geo = query.is_baby && c.owning_entity->v.use_dedicated_baby_armor;"
        ]
      },
      "render_controllers": [ "controller.render.armor.v2" ]
    }
  }
}
