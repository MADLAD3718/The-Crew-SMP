{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "minecraft:leather_helmet.piglin",
      "item": { "minecraft:leather_helmet": "query.is_owner_identifier_any('minecraft:piglin', 'minecraft:zombie_pigman', 'minecraft:piglin_brute')" },
      "materials": {
        "default": "armor_leather",
        "enchanted": "armor_leather_enchanted"
      },
      "textures": {
        "default": "textures/models/armor/leather_1",
        "enchanted": "textures/misc/enchanted_actor_glint",
        "baby": "textures/models/armor/leather_baby"
      },
      "geometry": {
        "default": "geometry.humanoid.armor.helmet",
        "baby": "geometry.piglin.baby.armor.helmet"
      },
      "scripts": {
        "pre_animation": [
          "variable.use_baby_geo = query.is_baby && c.owning_entity->v.use_dedicated_baby_armor;"
        ]
      },
      "render_controllers": [ "controller.render.armor.v2" ]
    }
  }
}
