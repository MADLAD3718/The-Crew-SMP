{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "tcsmp:grappling_hook",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/grappling_hook/grappling_hook",
        "pulling_0": "textures/items/grappling_hook/grappling_hook_pulled_0",
        "pulling_1": "textures/items/grappling_hook/grappling_hook_pulled_1",
        "pulling_2": "textures/items/grappling_hook/grappling_hook_pulled_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.grappling_hook",
        "pulling_0": "geometry.grappling_hook_pulling_0",
        "pulling_1": "geometry.grappling_hook_pulling_1",
        "pulling_2": "geometry.grappling_hook_pulling_2"
      },
      "animations": {
        "wield": "animation.crossbow.wield",
        "wield_offhand": "animation.crossbow.wield_offhand",
        "wield_first_person_pull": "animation.grappling_hook.wield_first_person_pull"
      },
      "scripts": {
        "parent_setup": "c.item_slot == 'main_hand' ? { v.use_attachable_animations_main_hand = 1.0; } : { v.use_attachable_animations_off_hand = 1.0; };",
        "initialize": [
          "v.is_in_offhand = c.item_slot == 'off_hand';"
        ],
        "pre_animation": [
          "v.max_use_duration = 1.0;", // Defined in seconds
          "v.item_use_normalized = (q.main_hand_item_max_duration - q.main_hand_item_use_duration) / (20 * v.max_use_duration);",
          "v.item_is_charged = q.main_hand_item_use_duration != 0.0 && v.item_use_normalized >= 1.0;",
          "v.animation_frame = v.item_is_charged ? 3 : math.floor(v.item_use_normalized * 4);",
          "v.is_first_person = c.is_first_person;"
        ],
        "animate": [
          {
            "wield": "c.item_slot == 'main_hand'"
          },
          {
            "wield_offhand": "v.is_in_offhand"
          },
          {
            "wield_first_person_pull": "q.main_hand_item_use_duration > 0.0f && c.is_first_person && c.item_slot == 'main_hand'"
          }
        ]
      },
      "render_controllers": [ "controller.render.grappling_hook" ]
    }
  }
}
