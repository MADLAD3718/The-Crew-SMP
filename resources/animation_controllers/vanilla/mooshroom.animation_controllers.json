{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.mooshroom.move" : {
			"initial_state" : "default",
			"states" : {
				"default" : {
					"animations" : [
						{
							"walk" : "query.modified_move_speed * (query.is_baby ? 0.23 / 0.35 : 1.0)"
						},
						"look_at_target"
					]
				}
			}
		}
	}
}
