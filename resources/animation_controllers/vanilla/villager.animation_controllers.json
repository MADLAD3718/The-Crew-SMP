{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.villager.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            {
              "move": "query.modified_move_speed * (query.is_baby ? 0.23 / 0.35 : 1.0)"
            }
          ]
        }
      }
    }
  }
}
