{
	"format_version": "1.8.0",
	"animations": {
		"animation.sailboat.sail": {
			"loop": true,
			"bones": {
				"back": {
					"rotation": [0, 0, "61 - math.atan2(41 - 2 * math.floor(v.throttle_interp * 15), 22.5)"],
					"scale": [1, "math.sqrt(22.5 * 22.5 + math.pow(41 - 2 * math.floor(v.throttle_interp * 15), 2)) / 47", 1]
				},
				"bottom": {
					"position": [0, "-2 * math.floor(v.throttle_interp * 15)", 0]
				}
			}
		},
		"animation.sailboat.wobble": {
			"animation_length": 1,
			"bones": {
				"boat": {
					"rotation": [0, 0, "(1 - q.property('tcsmp:last_hit_health') / q.max_health) * 15 * math.sin(q.anim_time * 180 * 6) * (1 - q.anim_time)"]
				}
			}
		},
		"animation.sailboat.ropes": {
			"loop": true,
			"bones": {
				"mast_rope": {
					"rotation": [0, "90 + q.rotation_to_camera(1) - q.body_y_rotation", 0]
				},
				"left_rope": {
					"rotation": [0, "90 + q.rotation_to_camera(1) - q.body_y_rotation", 0]
				},
				"right_rope": {
					"rotation": [0, "90 + q.rotation_to_camera(1) - q.body_y_rotation", 0]
				}
			}
		},
		"animation.sailboat.rudder": {
			"loop": true,
			"bones": {
				"rudder": {
					"rotation": [0, "-30 * v.turnrate_interp / 2.25", 0]
				}
			}
		}
	}
}