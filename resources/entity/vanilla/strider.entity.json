{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "minecraft:strider",
      "scripts": {
        "initialize": [
          "variable.speed = 85.9437;",
          "variable.bristle_range_mod=1;",
          "variable.bristle_speed_mod=1;"
        ],
        "pre_animation": [
          "variable.animation_speed = Math.min(query.modified_move_speed * (query.is_baby ? 0.23 / 0.35 : 1.0), 0.25);",
          "variable.bristle_flow=Math.cos(query.modified_distance_moved / (query.model_scale * 16.0) * variable.speed + 180) * variable.animation_speed;"
        ]
      }
    }
  }
}
