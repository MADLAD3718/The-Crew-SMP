{
  "format_version": "1.10",
  "render_controllers": {
    "controller.render.bow": {
      "arrays": {
        "textures": {
          "array.bow_texture_frames": [
            "texture.default",
            "texture.bow_pulling_0",
            "texture.bow_pulling_1",
            "texture.bow_pulling_2"
          ]
        },
        "geometries": {
          "array.bow_geo_frames": [
            "geometry.default",
            "geometry.bow_pulling_0",
            "geometry.bow_pulling_1",
            "geometry.bow_pulling_2"
          ]
        }
      },
      "geometry": "array.bow_geo_frames[variable.animation_frame]",
      "materials": [ { "*": "variable.is_enchanted ? material.enchanted : material.default" } ],
      "textures": [ "array.bow_texture_frames[variable.animation_frame]", "texture.enchanted" ],
      "part_visibility": [
        { "rightitem": "variable.is_first_person ? (variable.is_in_offhand ? !query.is_item_name_any('slot.weapon.mainhand', 'minecraft:filled_map', 'minecraft:map') && (query.is_item_name_any('slot.weapon.mainhand', 'minecraft:bow', 'minecraft:crossbow') ? !(query.main_hand_item_use_duration > 0.0 || query.item_is_charged) : 1.0) : 1.0) : 1.0" }
      ]
    }
  }
}
