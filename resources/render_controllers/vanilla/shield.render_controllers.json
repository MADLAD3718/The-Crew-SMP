{
  "format_version": "1.10",
  "render_controllers": {
    "controller.render.shield": {
      "geometry": "geometry.default",
      "materials": [ { "*": "variable.is_patterned ? (variable.is_enchanted ? material.pattern_enchanted : material.pattern) : (variable.is_enchanted ? material.enchanted : material.default)" } ],
      "textures": [
        "texture.default",
        "texture.enchanted",
        "texture.pattern"
      ],
      "part_visibility": [
        { "shield": "variable.is_first_person ? (query.is_item_name_any('slot.weapon.mainhand', 'minecraft:bow', 'minecraft:crossbow') ? query.main_hand_item_use_duration == 0.0 : 1.0) : 1.0" }
      ]
    }
  }
}
